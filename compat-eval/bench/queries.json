[
  {"name": "path_filter",
   "desc": "path with compound filter predicate",
   "expr": "systems.containers.components[properties.criticality = 'high' and properties.cost > 500].name"},
  {"name": "path_tags",
   "desc": "filter on array membership + projection to object",
   "expr": "systems.containers.components['pci' in tags].{'id': id, 'owner': properties.owner, 'n': $count(relations)}"},
  {"name": "group_agg",
   "desc": "grouping {} with $count/$sum/$max",
   "expr": "systems.containers.components{type: {'count': $count(id), 'cost': $sum(properties.cost), 'max': $max(properties.cost)}}",
   "sizes": [10000, 50000], "note": "O(n^2) in both engines: group values are accumulated with $append-style copying"},
  {"name": "group_nested",
   "desc": "group by owner within each system (nested group)",
   "expr": "systems.{'system': id, 'byOwner': containers.components{properties.owner: $sum(properties.cost)}}"},
  {"name": "join_scan",
   "desc": "join: first 20 relations, lookup by linear filter inside lambda (O(20*N))",
   "expr": "($c := systems.containers.components; $rels := $c.relations; $map($filter($rels, function($v, $i){ $i < 20 }), function($r){ $c[id = $r.target].name }))"},
  {"name": "join_index",
   "desc": "join: all relations via an index object built with $merge, $lookup inside lambda",
   "expr": "($c := systems.containers.components; $idx := $merge($c.{id: name}); $map($c.relations, function($r){ $lookup($idx, $r.target) }))"},
  {"name": "sort_fn",
   "desc": "$sort with a comparator lambda (cost desc, id asc)",
   "expr": "$sort(systems.containers.components, function($l, $r){ $l.properties.cost = $r.properties.cost ? $l.id > $r.id : $l.properties.cost < $r.properties.cost }).id",
   "js_sizes": [10000], "note": "jsonata-js 2.2.2 merge sort is O(n^2) in time and memory (slice(1) recursion); JS OOMs at 50k"},
  {"name": "orderby",
   "desc": "order-by operator ^(>cost, id)",
   "expr": "systems.containers.components^(>properties.cost, id).id",
   "js_sizes": [10000], "note": "same JS sort implementation as $sort"},
  {"name": "map_filter_reduce",
   "desc": "$map + $filter + $reduce chain with lambdas",
   "expr": "$reduce($filter($map(systems.containers.components, function($c){ $c.properties.cost * 2 }), function($v){ $v > 100 }), function($a, $b){ $a + $b }, 0)"},
  {"name": "strings",
   "desc": "string functions: $uppercase, $substringBefore, $split, $join, $length",
   "expr": "systems.containers.components.{'n': $uppercase($substringBefore(name, '-')) & '-' & $substringAfter(id, 'c'), 'w': $count($split(description, ' ')), 'j': $join(tags, '|'), 'l': $length(description)}"},
  {"name": "regex",
   "desc": "regex: $contains with regex, $replace with regex + backreference, $match",
   "expr": "systems.containers.components[$contains(description, /pay(ment)?s?\\b/)].{'n': $replace(name, /-([0-9]+)-/, '#$1#'), 'm': $match(description, /\\b[a-z]{7}\\b/)[0].match}"},
  {"name": "recursion_tree",
   "desc": "recursive walk over the whole document (counts objects), non-tail recursion depth ~7",
   "expr": "($walk := function($v){ $type($v) = 'object' ? 1 + $sum($each($v, function($x){ $walk($x) })) : $type($v) = 'array' ? $sum($map($v, function($x){ $walk($x) })) : 0 }; $walk($))",
   "js_sizes": [10000, 50000]},
  {"name": "tail_loop",
   "desc": "tail-recursive loop, iterations = number of components",
   "expr": "($loop := function($i, $acc){ $i = 0 ? $acc : $loop($i - 1, $acc + $i) }; $loop($count(systems.containers.components), 0))"},
  {"name": "fib",
   "desc": "non-tail recursion fib(18), data-independent (only run at smallest size)",
   "expr": "($fib := function($n){ $n < 2 ? $n : $fib($n - 1) + $fib($n - 2) }; $fib(18))",
   "sizes": [10000]}
]
